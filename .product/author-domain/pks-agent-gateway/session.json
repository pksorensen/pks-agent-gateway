{
  "product": "pks-agent-gateway",
  "participants": [],
  "graph": {
    "contexts": [
      {
        "id": "catalog",
        "label": "Catalog",
        "purpose": "What the gateway publishes: upstream APIs and their operations, MCP servers and their tools, and the bundles that group them (PRD F2-F8)."
      },
      {
        "id": "access",
        "label": "Access",
        "purpose": "Who may call what: principals (human or service) and their subscriptions to bundles, each carrying a primary and secondary key (PRD F10-F12)."
      },
      {
        "id": "credentials",
        "label": "Credentials",
        "purpose": "Upstream credentials the gateway injects on the caller's behalf; values never leave the gateway (PRD F13-F14, ADR 0002)."
      },
      {
        "id": "governance",
        "label": "Governance",
        "purpose": "Typed policy evaluated on every data-plane request, the request decision itself, and usage attributed to the authenticated subscription (PRD F15-F17)."
      }
    ],
    "entities": [
      {
        "id": "Api",
        "label": "",
        "context": "catalog",
        "definition": "An upstream HTTP service published under a public path prefix; kind http or llm; forwards only its declared operations.",
        "identity": "api id (unique per owner)",
        "is_aggregate_root": true
      },
      {
        "id": "Operation",
        "label": "",
        "context": "catalog",
        "definition": "One method + path template of an Api, imported from OpenAPI or declared by hand; the unit an MCP tool maps to.",
        "identity": "api id + operation id",
        "is_aggregate_root": false
      },
      {
        "id": "McpServer",
        "label": "",
        "context": "catalog",
        "definition": "An MCP tool server exposed at /mcp/{server}: either generated from an Api's operations or a passthrough to a remote Streamable-HTTP server with an optional tool allow-list.",
        "identity": "server name (the /mcp/{server} segment)",
        "is_aggregate_root": true
      },
      {
        "id": "Tool",
        "label": "",
        "context": "catalog",
        "definition": "One MCP tool of an McpServer; name, description and inputSchema default from its Operation and may be overridden.",
        "identity": "server name + tool name",
        "is_aggregate_root": false
      },
      {
        "id": "Bundle",
        "label": "",
        "context": "catalog",
        "definition": "A named group of Apis and McpServers that principals subscribe to (APIM's Product; label open for renaming). State published or hidden.",
        "identity": "bundle id",
        "is_aggregate_root": true
      },
      {
        "id": "Principal",
        "label": "",
        "context": "access",
        "definition": "Who a subscription belongs to: a human (Keycloak OIDC sub) or a non-human service principal that authenticates to the data plane only through a subscription key.",
        "identity": "OIDC sub (human) or service-principal id",
        "is_aggregate_root": true
      },
      {
        "id": "Subscription",
        "label": "",
        "context": "access",
        "definition": "A principal's access to one bundle: a named container for two live keys (primary, secondary) with state active, suspended, cancelled or expired (label open for renaming).",
        "identity": "subscription id",
        "is_aggregate_root": true
      },
      {
        "id": "Credential",
        "label": "",
        "context": "credentials",
        "definition": "An upstream secret the gateway resolves (env, sealed, vault or entra) and injects (header, query or bearer); the management plane never returns its value.",
        "identity": "credential id",
        "is_aggregate_root": true
      },
      {
        "id": "Policy",
        "label": "",
        "context": "governance",
        "definition": "A typed, declarative rule (set-header, strip-header, rate-limit, token-limit, ip-allow) at global, bundle, api or subscription scope; no expression language.",
        "identity": "policy id",
        "is_aggregate_root": true
      },
      {
        "id": "GatewayRequest",
        "label": "",
        "context": "governance",
        "definition": "One data-plane call (HTTP route or MCP tools/call) presenting a subscription key; decided as authorized or rejected before anything reaches an upstream.",
        "identity": "request id",
        "is_aggregate_root": true
      },
      {
        "id": "UsageRecord",
        "label": "",
        "context": "governance",
        "definition": "The attributed record of one data-plane call: subscription, principal, bundle, api or tool, status, latency, bytes, and for llm apis input/output tokens and model.",
        "identity": "request id",
        "is_aggregate_root": true
      }
    ],
    "value_objects": [
      {
        "id": "SubscriptionKey",
        "label": "",
        "context": "access",
        "definition": "One of a subscription's two keys (slot primary or secondary); shown to the caller exactly once, stored only as a sha256 hash, compared in constant time."
      },
      {
        "id": "InjectionSpec",
        "label": "",
        "context": "credentials",
        "definition": "Where a resolved credential is placed on the upstream request: a header name, a query parameter, or a bearer token."
      },
      {
        "id": "PolicyScope",
        "label": "",
        "context": "governance",
        "definition": "The level a policy attaches to (global, bundle, api, subscription) plus the target id; evaluation order is fixed global -> bundle -> api -> subscription."
      },
      {
        "id": "ConnectionSnippet",
        "label": "",
        "context": "access",
        "definition": "What a subscriber needs to connect: base URL, key header, and a ready-to-merge .mcp.json fragment."
      }
    ],
    "relations": [
      {
        "id": "api-has-operations",
        "from": "Api",
        "to": "Operation",
        "cardinality": "1..0..*",
        "rationale": "Only declared operations are forwarded (FR-3), so an Api owns its operation set."
      },
      {
        "id": "mcp-has-tools",
        "from": "McpServer",
        "to": "Tool",
        "cardinality": "1..0..*",
        "rationale": "tools/list and tools/call are answered from the server's tool set (FR-4, FR-5)."
      },
      {
        "id": "tool-maps-operation",
        "from": "Tool",
        "to": "Operation",
        "cardinality": "0..*..0..1",
        "rationale": "A generated tool is one operation (FR-4); a remote-server tool maps to none."
      },
      {
        "id": "mcp-generated-from-api",
        "from": "McpServer",
        "to": "Api",
        "cardinality": "0..*..0..1",
        "rationale": "A from-api server is created by picking operations of one Api (FR-4)."
      },
      {
        "id": "bundle-contains-api",
        "from": "Bundle",
        "to": "Api",
        "cardinality": "0..*..0..*",
        "rationale": "Bundles group Apis for subscription (FR-7)."
      },
      {
        "id": "bundle-contains-mcp",
        "from": "Bundle",
        "to": "McpServer",
        "cardinality": "0..*..0..*",
        "rationale": "Bundles group MCP servers; tools/list filters by bundle coverage (FR-6, FR-7)."
      },
      {
        "id": "subscription-to-bundle",
        "from": "Subscription",
        "to": "Bundle",
        "cardinality": "0..*..1",
        "rationale": "v1 supports bundle scope only (F11)."
      },
      {
        "id": "subscription-of-principal",
        "from": "Subscription",
        "to": "Principal",
        "cardinality": "0..*..1",
        "rationale": "Every subscription belongs to exactly one principal, human or service (FR-8)."
      },
      {
        "id": "subscription-keys",
        "from": "Subscription",
        "to": "SubscriptionKey",
        "cardinality": "1..2",
        "rationale": "Two live keys so rotation is not a flag day (F10, FR-10)."
      },
      {
        "id": "api-uses-credential",
        "from": "Api",
        "to": "Credential",
        "cardinality": "0..*..0..1",
        "rationale": "An Api references at most one credential to inject upstream (FR-1, FR-13)."
      },
      {
        "id": "credential-injects",
        "from": "Credential",
        "to": "InjectionSpec",
        "cardinality": "1..1",
        "rationale": "Every credential declares exactly one injection (FR-13)."
      },
      {
        "id": "policy-scoped",
        "from": "Policy",
        "to": "PolicyScope",
        "cardinality": "1..1",
        "rationale": "A policy attaches to exactly one scope (FR-16)."
      },
      {
        "id": "usage-for-subscription",
        "from": "UsageRecord",
        "to": "Subscription",
        "cardinality": "0..*..1",
        "rationale": "Usage is attributed by the authenticated subscription, never self-declared (F17, FR-17)."
      },
      {
        "id": "request-presents-subscription",
        "from": "GatewayRequest",
        "to": "Subscription",
        "cardinality": "0..*..0..1",
        "rationale": "A request is resolved to at most one subscription by its presented key (FR-11)."
      }
    ],
    "invariants": [
      {
        "id": "INV-API-UNIQUE",
        "statement": "An api id is registered at most once per owner.",
        "context": "catalog",
        "applies_to": "Api"
      },
      {
        "id": "INV-API-KIND",
        "statement": "An api's kind is a member of ApiKind (http | llm).",
        "context": "catalog",
        "applies_to": "Api"
      },
      {
        "id": "INV-API-LIVE",
        "statement": "Only a registered, not-removed api can be updated, removed, imported into or given operations.",
        "context": "catalog",
        "applies_to": "Api"
      },
      {
        "id": "INV-MCP-UNIQUE",
        "statement": "An MCP server name is used at most once; a removed server cannot be changed.",
        "context": "catalog",
        "applies_to": "McpServer"
      },
      {
        "id": "INV-MCP-SOURCE",
        "statement": "A from-api server names an existing api and at least one of its operations; a remote server names a Streamable-HTTP URL (SSE is not accepted).",
        "context": "catalog",
        "applies_to": "McpServer"
      },
      {
        "id": "INV-BUNDLE-UNIQUE",
        "statement": "A bundle id is created at most once.",
        "context": "catalog",
        "applies_to": "Bundle"
      },
      {
        "id": "INV-BUNDLE-HIDE-KEEPS-KEYS",
        "statement": "Hiding a bundle does not invalidate existing subscriptions or keys (FR-7).",
        "context": "catalog",
        "applies_to": "Bundle"
      },
      {
        "id": "INV-PRINCIPAL-SERVICE-KEY-ONLY",
        "statement": "A service principal authenticates to the data plane only through a subscription key; a disabled principal cannot be subscribed (FR-12).",
        "context": "access",
        "applies_to": "Principal"
      },
      {
        "id": "INV-SUB-UNIQUE",
        "statement": "A subscription id is created at most once.",
        "context": "access",
        "applies_to": "Subscription"
      },
      {
        "id": "INV-SUB-BUNDLE-SCOPE",
        "statement": "In v1 a subscription is scoped to exactly one bundle; api and all-apis scopes are not offered to subscribers (F11).",
        "context": "access",
        "applies_to": "Subscription"
      },
      {
        "id": "INV-SUB-KEYS-SHOWN-ONCE",
        "statement": "Primary and secondary keys are returned exactly once (on creation or regeneration); only their sha256 hashes are stored (FR-8, NFR-4).",
        "context": "access",
        "applies_to": "Subscription"
      },
      {
        "id": "INV-SUB-TRANSITIONS",
        "statement": "Allowed transitions: active -> suspended, suspended -> active, active|suspended -> cancelled, active|suspended -> expired (FR-9).",
        "context": "access",
        "applies_to": "Subscription"
      },
      {
        "id": "INV-SUB-CANCELLED-TERMINAL",
        "statement": "Cancelled is terminal: no reactivation, suspension or key regeneration afterwards (FR-9).",
        "context": "access",
        "applies_to": "Subscription"
      },
      {
        "id": "INV-SUB-SELF-SERVICE",
        "statement": "A key may be regenerated by a GatewayAdmin or by the subscription's own principal, and only one slot at a time (FR-10).",
        "context": "access",
        "applies_to": "Subscription"
      },
      {
        "id": "INV-CRED-VALUE-NEVER-RETURNED",
        "statement": "The management plane never returns a credential's value; upstream secrets never appear in responses, logs, OTEL, cassettes or errors (FR-13, NFR-1).",
        "context": "credentials",
        "applies_to": "Credential"
      },
      {
        "id": "INV-CRED-SOURCE",
        "statement": "A credential's source is a member of CredentialSource and its injection a member of InjectionMode.",
        "context": "credentials",
        "applies_to": "Credential"
      },
      {
        "id": "INV-POLICY-TOKEN-LIMIT-LLM",
        "statement": "A token-limit policy applies only to llm apis (FR-16).",
        "context": "governance",
        "applies_to": "Policy"
      },
      {
        "id": "INV-POLICY-FIXED-ORDER",
        "statement": "Policies evaluate in fixed order global -> bundle -> api -> subscription; no expression language (FR-16).",
        "context": "governance",
        "applies_to": "Policy"
      },
      {
        "id": "INV-REQ-KEY-REQUIRED",
        "statement": "The subscription lane always requires a key, even in open management mode (NFR-7).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-REQ-SUB-ACTIVE",
        "statement": "A request is authorized only if its key hash matches the primary or secondary key of an active subscription (FR-9, FR-11).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-REQ-DECLARED-OP",
        "statement": "Only paths matching a declared operation are forwarded; anything else under the api prefix is answered 404 locally (FR-3).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-REQ-BUNDLE-COVERS",
        "statement": "The subscription's bundle must contain the api or MCP server addressed; tools/list shows only covered tools (FR-6).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-REQ-WITHIN-POLICY",
        "statement": "A request over a rate-limit or token-limit is rejected with 429 and retry-after (FR-16, story 7).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-REQ-KEY-STRIPPED",
        "statement": "The presented subscription key is stripped before forwarding upstream (FR-11).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-REQ-LANE-ISOLATION",
        "statement": "sim- keys never reach an upstream; passthrough traffic never gets an injected credential; subscription traffic never reaches the default UPSTREAM (NFR-2).",
        "context": "governance",
        "applies_to": "GatewayRequest"
      },
      {
        "id": "INV-USAGE-ONE-PER-CALL",
        "statement": "Every data-plane call writes exactly one usage record, attributed to the authenticated subscription (FR-17).",
        "context": "governance",
        "applies_to": "UsageRecord"
      },
      {
        "id": "INV-MCP-OAUTH-RESOURCE-ONLY",
        "statement": "On an MCP endpoint, a bearer JWT is accepted only when it is issued by the owner's configured authorization server (Keycloak or Entra ID), its audience is that MCP server's URL, and its sub resolves to a Principal holding an active Subscription on a Bundle that contains the server; the gateway itself never issues tokens.",
        "applies_to": "GatewayRequest"
      }
    ],
    "context_mappings": [
      {
        "id": "principal-is-oidc-sub",
        "concept_a": "Principal",
        "concept_b": "Subscription",
        "kind": "customer-supplier",
        "rationale": "Access owns Principal; a human principal's identity is supplied by Keycloak (OIDC sub), which the gateway conforms to rather than models."
      },
      {
        "id": "api-credential-ref",
        "concept_a": "Api",
        "concept_b": "Credential",
        "kind": "customer-supplier",
        "rationale": "Catalog references credentials by id only; Credentials supplies resolution and injection and never exposes the value to Catalog."
      }
    ],
