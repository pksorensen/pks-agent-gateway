        "id": "sys-gateway-runtime",
        "label": "Gateway runtime (data plane)",
        "kind": "service",
        "purpose": "Accepts HTTP and LLM calls carrying a subscription key, applies policy, swaps in the upstream credential, streams the upstream response unbuffered, and records usage.",
        "target_platforms": [
          "linux-container"
        ],
        "references_domain": [
          "catalog",
          "access",
          "credentials",
          "governance"
        ]
      },
