        "id": "sys-management-api",
        "label": "Management API",
        "kind": "service",
        "purpose": "The /api/v1 management surface (OIDC bearer; GatewayAdmin or subscriber self-service) that every management verb goes through.",
        "target_platforms": [
          "linux-container"
        ],
        "references_domain": [
          "catalog",
          "access",
          "credentials",
          "governance"
        ]
      },
      {
        "id": "sys-gateway-cli",
        "label": "gateway-cli",
        "kind": "cli",
        "purpose": "The operator's and subscriber's terminal: every management verb (api, op, mcp, bundle, sub, principal, cred, policy, usage, catalog) plus sub env.",
        "target_platforms": [
          "linux",
          "macos",
          "windows"
        ],
        "target_classes": [
          "tui"
        ],
        "references_domain": [
          "catalog",
          "access",
          "credentials",
