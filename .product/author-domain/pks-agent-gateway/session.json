          "linux-container"
        ],
        "references_domain": [
          "catalog",
          "access",
          "credentials",
          "governance"
        ]
      },
      {
        "id": "sys-mcp-endpoint",
        "label": "MCP endpoint (/mcp/{server})",
        "kind": "service",
        "purpose": "Serves tools/list and tools/call for generated and remote MCP servers, filtered to the tools the presented subscription's bundle covers.",
        "target_platforms": [
          "linux-container"
        ],
        "references_domain": [
          "catalog",
          "access",
          "governance"
        ]
      },
